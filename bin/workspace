#!/usr/bin/env bash
# workspace — tmux for the repos of config.yaml (~/.config/ai-tmux-workspace/).
#   workspace                 opens (or reattaches) the workspace; the agent (claude, deepseek...) comes from "agent" in config.yaml (Ctrl+b o)
#   workspace install         links `workspace` into ~/.local/bin
#   workspace update          git pull --ff-only do clone instalado (app/); clone sujo aborta; checkout de dev é recusado
#   workspace --help          this list; does not open tmux
#   workspace install-hooks   registers the Claude Code hooks that light the dots
#   workspace restart [profile] kill the tmux server and start again (Claude resumes with --continue)
#   workspace fit [profile]    re-apply the layout once, only what changed (run by the tmux hooks on attach/resize)
#   workspace reload [profile] reload tmux.conf, restart the panels (picks up code changes) and add the tab strip to open windows (no restart)
#   workspace doctor          drift check of the installed harness (--warn: only warns, used by reload)
#   workspace config [update [--apply]]  show the config; update compares config.yaml, the harness, settings and hooks with this repo (src/config_cmd.py)
#   workspace worktree new <repo> <branch> [base] | list <repo> | remove <repo> <branch> | merge <repo> <branch>
#   workspace privileged <cmd...>  system step: full command on a separate screen, exit code returned
#   workspace repo list | on <nome> | off <nome>  repos of the "repos_folder" and their switch (config.yaml)
#   workspace dev [profile]   window on the workspace's own code (role self): the only session that edits it; not in config
#   workspace stop [profile]   kill the profile's tmux server
#   workspace request send <home|repo> <conversa|execucao> <texto> [-- comando...] | inbox | approve <id> | refuse <id>
#                             pedido entre sessões: só tem efeito depois da aprovação da pessoa no receptor
# Internal (called from inside tmux): open <repo> · side <tree|diff|github> · left <repos|sessions>
#   session-menu|session-new|session-run|session-exit  (profile sessions) · tab-new|tab-show|tab-step|tab-exit  (temporary terminal tabs) · plugins-sync <profile>
set -u
BIN="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
ROOT="$(dirname "$BIN")"        # repo root
SRC="$ROOT/src"
export WS_DIR="$ROOT"
MOBILE_W=100   # windows narrower than this (columns) use the phone layout: one zoomed view + hamburger menu
SESSION_MIN_SECONDS=10   # shorter than this, a session that ended was a failed launch (never reopen the default)

msg() { python3 "$SRC/i18n.py" "$@"; }   # i18n text: msg <key> [name=value ...]
profile_cmd() { python3 "$SRC/lib.py" profile-cmd "$1" "${2:-}"; }
# Generates the settings of every profile without starting the agent (reload). A config error does not
# fail the reload: the specific message goes to stderr and the other profiles continue.
settings_refresh() { python3 "$SRC/lib.py" ensure-settings "${1:-}" >/dev/null || true; }
settings_refresh_all() {
  local p
  while read -r p; do [ -n "$p" ] && settings_refresh "$p"; done < <(python3 "$SRC/lib.py" profile-names)
}
env_global() { tmux show-environment -g "$1" 2>/dev/null | cut -d= -f2-; }
doctor() { python3 "$SRC/drift.py" "$@"; }
loop_cmd() { # $1 = repos | tasks | tree | sessions | diff | github | tabs [claude|terminal]
  printf 'while :; do python3 %q %s; sleep 1; done' "$SRC/panel_$1.py" "${2:-}"
}

# Side column widths: a share of the window, clamped so they stay usable on small and ultrawide screens.
col_w() { # $1=left|right  $2=window width
  local pct min max w
  case "$1" in left) pct=22 min=28 max=44;; *) pct=19 min=24 max=44;; esac
  [ "$2" -lt "$MOBILE_W" ] && min=8   # phone: side panes are never seen side by side (zoomed one at a time)
  w=$(( $2 * pct / 100 )); [ "$w" -lt "$min" ] && w=$min; [ "$w" -gt "$max" ] && w=$max
  echo "$w"
}
# Terminal height: 17% of the Claude pane plus the 1 line the terminal tab strip takes back.
term_h() { echo $(( ($(tmux display -p -t "$1" '#{window_height}') - 2) * 17 / 100 + 1 )); }

# Repo pane tree, in creation order (the order decides how much room each split takes).
# One line per pane: role|parent|split|size|command. The claude pane is the window itself (not in the tree).
#   split: v (stacked) | h (side by side); b = before the parent; f = full (window height/width)
#   size: lines, N%, or TERM / LEFT / RIGHT (computed at build time); empty = half of the parent
#   command: shell (plain shell, restarted at its final size), loop_cmd:<panel>, tabs:<strip>
REPO_TREE='tabs|claude|vb|2|tabs:session
terminal|claude|v|TERM|shell
ttabs|terminal|vb|1|tabs:terminal
repos|claude|hbf|LEFT|loop_cmd:repos
tasks|repos|v|50%|loop_cmd:tasks
rtabs|repos|vb|2|tabs:repos
ktabs|tasks|vb|1|tabs:tasks
side|claude|hf|RIGHT|loop_cmd:tree
dtabs|side|vb|2|tabs:side'

# Pane with a given role in a window. "terminal" also matches the temporary "ttmp N" tab standing in for it.
pane_with_role() { # $1=window $2=role
  tmux list-panes -t "$1" -F '#{pane_id}|#{@role}' |
    awk -F'|' -v r="$2" '$2==r || (r=="terminal" && $2 ~ /^ttmp /){print $1; exit}'
}

# Creates, in tree order, the panes the window lacks (a role already present is skipped, and so is a missing parent).
# Does not apply the final sizes: layout_apply is the only owner of the geometry, and the caller runs it
# once after all panes exist. Shell panes are started only after that (shells_start), at their final size.
build_tree() { # $1=window $2=repo path $3=tree (see REPO_TREE)
  local W="$1" path="$2" tree="$3" role parent split size cmd anchor P width id dir sh
  local opts
  LAYOUT_SHELLS=""
  P="$(pane_with_role "$W" claude)"; [ -n "$P" ] || return 0
  width="$(tmux display -p -t "$W" '#{window_width}')"
  while IFS='|' read -r role parent split size cmd; do
    case "$role" in ''|\#*) continue ;; esac
    [ -n "$(pane_with_role "$W" "$role")" ] && continue
    anchor="$(pane_with_role "$W" "$parent")"; [ -n "$anchor" ] || continue
    case "$size" in
      TERM) size="$(term_h "$P")" ;;
      LEFT) size="$(col_w left "$width")" ;;
      RIGHT) size="$(col_w right "$width")" ;;
    esac
    dir=-v; case "$split" in h*) dir=-h ;; esac
    opts=(-d "$dir")
    case "$split" in *b*) opts+=(-b) ;; esac
    case "$split" in *f*) opts+=(-f) ;; esac
    [ -n "$size" ] && opts+=(-l "$size")
    sh=""
    case "$cmd" in loop_cmd:*) sh="$(loop_cmd "${cmd#loop_cmd:}")" ;; tabs:*) sh="$(loop_cmd tabs "${cmd#tabs:}")" ;; esac
    if [ -n "$sh" ]; then
      id="$(tmux split-window "${opts[@]}" -t "$anchor" -c "$path" -P -F '#{pane_id}' "$sh")"
    else
      id="$(tmux split-window "${opts[@]}" -t "$anchor" -c "$path" -P -F '#{pane_id}')"
    fi
    tmux set -p -t "$id" @role "$role"
    [ "$cmd" = shell ] && LAYOUT_SHELLS="$LAYOUT_SHELLS $id"
  done <<<"$tree"
  return 0
}

# Starts the shell panes build_tree just created, only now, at their final size: a resize while zsh
# starts prints a stray "%". Always run it right after layout_apply (build_tree fills LAYOUT_SHELLS).
shells_start() { # $1=path
  local id
  for id in ${LAYOUT_SHELLS:-}; do tmux respawn-pane -k -t "$id" -c "$1"; done
  LAYOUT_SHELLS=""
}

# Builds a repo window:  [repos | claude (5) / terminal (1) | side]   ~22% : rest : ~19% (clamped)
build_window() { # $1=path  $2=-d (do not select)
  local path="$1" d="${2:-}" S name W P T focus
  S="$(env_global WS_PROFILE)"
  name="$(basename "$path")"
  # The window is always built hidden: every pane (placeholder, strips, sessions, shells) is mounted
  # off screen, so the person sees it already assembled instead of one pane appearing at a time.
  W="$(tmux new-window -d -P -F '#{window_id}' -t "$S:" -n "$name" -c "$path")"
  P="$(tmux display -p -t "$W" '#{pane_id}')"
  tmux set -w -t "$W" @ws_repo "$path"
  tmux set -w -t "$W" @ws_profile "$S"
  tmux set -w -t "$W" @ws_session_profile ""
  tmux set -w -t "$W" @ws_mview session
  tmux set -p -t "$P" @role claude
  tmux set -p -t "$P" @ws_placeholder 1
  init_tabs "$W" "$P" s
  build_tree "$W" "$path" "$REPO_TREE"
  T="$(pane_with_role "$W" terminal)"
  [ -n "$T" ] && init_tabs "$W" "$T" t
  # The main pane starts as the SESSÕES placeholder, so no session is adopted by mistake; the
  # restore/default step below turns it into the first session.
  tmux respawn-pane -k -t "$P" -c "$path" "python3 '$SRC/session_placeholder.py'"
  tmux select-pane -t "$P"
  # Restore the recorded session tabs (order, profile and session id) or open the default profile
  # only when the repo has no recorded tab.
  open_sessions "$W" "$path"
  # the layout is applied once, after every pane exists; then the shells start at their final size
  layout_apply "$W"
  shells_start "$path"
  # Only now reveal the window, with the layout already in the target geometry: the fit fired by
  # session-window-changed then finds nothing to resize. $2=-d keeps it hidden for the caller.
  [ -n "$d" ] && return 0
  tmux select-window -t "$W"
  # focus on the main screen: the active tab (or the main Claude)
  focus="$(tmux show -wqv -t "$W" @ws_active)"
  tab_alive "$focus" 2>/dev/null || focus="$(pane_with_role "$W" claude)"
  [ -n "$focus" ] && tmux select-pane -t "$focus"
  return 0
}

# --- Temporary tabs (Claude and terminal) ------------------------------------------------------
# Two independent strips, each with the same pattern: the first tab is the main one (role `claude`
# / `terminal`), the others are new panes in the same repo (role `tmp N` / `ttmp N`). Each tab is a
# pane: the visible one takes the main pane's space, the others stay in a hidden window
# ("tab:<repo>" / "ttab:<repo>") and swap places with swap-pane. The strip is a 1-row panel
# (panel_tabs.py <claude|terminal>).
tab_alive() { tmux list-panes -a -F '#{pane_id}' | grep -qxF "$1"; }

# $1=any role (main, temporary or strip) -> sets the kind: s (session) or t (terminal)
tab_kind() { case "$1" in terminal|ttmp*|ttabs) echo t ;; *) echo s ;; esac; }

# $1=s|t -> define K_TABS K_ACT K_NEXT K_MAIN K_TMP K_HID K_STRIP
tab_vars() {
  if [ "$1" = t ]; then
    K_TABS=@ws_ttabs K_ACT=@ws_term_active K_NEXT=@ws_tnext K_MAIN=terminal K_TMP=ttmp K_HID=ttab K_STRIP=ttabs
  else
    K_TABS=@ws_tabs K_ACT=@ws_active K_NEXT=@ws_next K_MAIN=claude K_TMP=tmp K_HID=tab K_STRIP=tabs
  fi
}

# $1=window $2=main pane of the strip $3=s|t: registers the main tab (list, active, next number).
# For sessions, the main pane is the empty placeholder, not a session, so nothing is registered.
init_tabs() {
  local W="$1" P="$2"
  tab_vars "$3"
  [ "$3" = s ] && return 0
  [ -n "$(tmux show -wqv -t "$W" $K_TABS)" ] || {
    tmux set -w -t "$W" $K_TABS "$P"; tmux set -w -t "$W" $K_ACT "$P"; tmux set -w -t "$W" $K_NEXT 2; }
}

tab_list() { # $1=window $2=s|t: live ids, in order
  local p prof kind="${2:-s}"
  tab_vars "$kind"
  if [ "$kind" = s ]; then
    # A window opened before sessions existed: adopt the main pane as a legacy session. The empty
    # placeholder is not a session, so a fresh window with no sessions stays empty.
    if [ -z "$(tmux show -wqv -t "$1" $K_TABS)" ]; then
      p="$(pane_with_role "$1" claude)"
      if [ -n "$p" ] && [ -z "$(tmux show -pqv -t "$p" @ws_placeholder)" ]; then
        prof="$(tmux show -wqv -t "$1" @ws_profile)"
        tmux set -w -t "$1" $K_TABS "$p"
        tmux set -w -t "$1" $K_ACT "$p"
        tmux set -w -t "$1" @ws_next 2
        tmux set -p -t "$p" @ws_tab_profile "$prof"
        tmux set -w -t "$1" @ws_session_profile "$prof"
      fi
    fi
  else
    # Terminal tab opened before tabs existed: adopt the main pane.
    if [ -z "$(tmux show -wqv -t "$1" $K_TABS)" ]; then
      p="$(tmux list-panes -t "$1" -F '#{pane_id}|#{@role}' | awk -F'|' -v r="$K_MAIN" '$2==r{print $1; exit}')"
      if [ -n "$p" ]; then
        tmux set -w -t "$1" $K_TABS "$p"
        [ -n "$(tmux show -wqv -t "$1" $K_ACT)" ] || tmux set -w -t "$1" $K_ACT "$p"
        tmux set -w -t "$1" $K_NEXT 2
      fi
    fi
  fi
  for p in $(tmux show -wqv -t "$1" $K_TABS); do tab_alive "$p" && echo "$p"; done
}

# Asks a strip panel to re-read its state and redraw (SIGUSR1), instead of respawning it on every tab
# change. If it is not running, the panel loop starts it within 1s and it draws the current state.
panel_signal() { # $1=window $2=strip role
  local pane pid
  pane="$(pane_with_role "$1" "$2")"; [ -n "$pane" ] || return 0
  pid="$(tmux display -p -t "$pane" '#{pane_pid}' 2>/dev/null)"; [ -n "$pid" ] || return 0
  pkill -USR1 -P "$pid" -f 'panel_tabs.py' 2>/dev/null || true
  return 0
}

tab_render() { # $1=window $2=s|t: the strip rereads the state and redraws only what changed
  local kind="${2:-s}"
  tab_vars "$kind"
  panel_signal "$1" "$K_STRIP"
}

tab_show() { # $1=window $2=tab pane
  local W="$1" T="$2" current kind prof
  tab_alive "$T" || return 1
  kind="$(tab_kind "$(tmux show -pqv -t "$T" @role)")"; tab_vars "$kind"
  current="$(tmux show -wqv -t "$W" $K_ACT)"
  if [ "$current" != "$T" ]; then
    # -Z keeps the window zoomed: on the phone the session that enters the slot is already inside the
    # geometry, so the switch needs no resize/zoom afterwards (older tmux: plain swap, next fit fixes it).
    tmux swap-pane -dZ -s "$T" -t "$current" || tmux swap-pane -d -s "$T" -t "$current" || return 1
    tmux set -w -t "$W" $K_ACT "$T"
    if [ "$kind" = s ]; then
      # keep the slot anchored to role `claude`: the pane now in the slot becomes the main one and the
      # one that left becomes a hidden session tab (its profile tag travels with the pane).
      tmux set -p -t "$T" @role claude
      tmux set -p -t "$T" @ws_owner "$W"
      tmux set -p -t "$current" @role tab
      tmux set -p -t "$current" @ws_owner "$W"
    fi
  fi
  tmux select-pane -t "$T"
  tab_render "$W" "$kind"
  if [ "$kind" = s ]; then
    prof="$(tmux show -pqv -t "$T" @ws_tab_profile)"
    tmux set -w -t "$W" @ws_session_profile "$prof"
    tmux set -w -t "$W" @ws_mview session
    state_active_tab "$W" "$T"
  else
    tmux set -w -t "$W" @ws_mview terminal
  fi
}

tab_new() { # $1=window $2=role of the focused pane (sets the kind; default session)
  local W="$1" S cmd path n P kind
  kind="$(tab_kind "${2:-}")"; tab_vars "$kind"
  if [ "$kind" = s ]; then session_menu "$W"; return 0; fi
  S="$(env_global WS_PROFILE)"
  path="$(tmux show -wqv -t "$W" @ws_repo)"
  [ -n "$path" ] || return 1
  cmd="${SHELL:-bash}"
  n="$(tmux show -wqv -t "$W" $K_NEXT)"; n="${n:-2}"
  P="$(tmux new-window -d -P -F '#{pane_id}' -t "$S:" -n "$K_HID:$(basename "$path")" -c "$path")"
  tmux set -p -t "$P" @role "$K_TMP $n"; tmux set -p -t "$P" @ws_owner "$W"
  tmux set -w -t "$W" $K_TABS "$(tab_list "$W" "$kind" | tr '\n' ' ')$P"
  tmux set -w -t "$W" $K_NEXT $((n + 1))
  # Terminal: swap first, then start the shell at its final size (a resize while zsh starts
  # prints a stray "%"), with no typed command line either.
  tab_show "$W" "$P"
  tmux respawn-pane -k -t "$P" -c "$path" "cd ${path@Q}; $cmd; '$BIN/workspace' tab-exit \"\$TMUX_PANE\""
}

tab_step() { # $1=window $2=+1|-1 $3=role of the focused pane (sets the kind)
  local W="$1" active ids i=0 idx=0 n kind p
  kind="$(tab_kind "${3:-}")"; tab_vars "$kind"
  active="$(tmux show -wqv -t "$W" $K_ACT)"
  mapfile -t ids < <(tab_list "$W" "$kind"); n=${#ids[@]}
  [ "$n" -gt 1 ] || return 0
  for p in "${ids[@]}"; do [ "$p" = "$active" ] && idx=$i; i=$((i + 1)); done
  tab_show "$W" "${ids[$(( (idx + $2 + n) % n ))]}"
}

tab_exit() { # $1=pane that ended: returns focus to the main one and removes the tab from the list
  local P="$1" W main kind
  W="$(tmux show -pqv -t "$P" @ws_owner 2>/dev/null)"
  [ -n "$W" ] || return 0
  kind="$(tab_kind "$(tmux show -pqv -t "$P" @role)")"; tab_vars "$kind"
  main="$(tab_list "$W" "$kind" | head -1)"
  [ "$(tmux show -wqv -t "$W" $K_ACT)" = "$P" ] && [ -n "$main" ] && tab_show "$W" "$main"
  tmux set -w -t "$W" $K_TABS "$(tab_list "$W" "$kind" | grep -vxF "$P" | tr '\n' ' ')"
  tab_render "$W" "$kind"
}

open_repo() {
  local path S existing
  path="$(readlink -f "${1/#\~/$HOME}")"; S="$(env_global WS_PROFILE)"
  [ -d "$path" ] || { msg cli.not_exists path="$path" >&2; exit 1; }
  python3 "$SRC/lib.py" repo-enabled "$path" || exit 1   # switched off: no window, no agent (message on stderr)
  existing="$(tmux list-windows -t "$S:" -F '#{window_id}|#{@ws_repo}' | awk -F'|' -v p="$path" '$2==p {print $1; exit}')"
  if [ -n "$existing" ]; then
    tmux select-window -t "$existing"
    # focus on the main screen: the active tab (or the main Claude)
    local focus; focus="$(tmux show -wqv -t "$existing" @ws_active)"
    tab_alive "$focus" 2>/dev/null || focus="$(tmux list-panes -t "$existing" -F '#{pane_id}|#{@role}' | awk -F'|' '$2=="claude"{print $1}')"
    [ -n "$focus" ] && tmux select-pane -t "$focus"
    tmux set -w -t "$existing" @ws_mview session   # phone: picking a repo lands on its session
    layout_apply "$existing"
    return
  fi
  build_window "$path" || return 1        # profile settings error: the message already went to stderr
  # the starting window ("boot") goes away once a repo is open
  tmux list-windows -t "$S:" -F '#{window_id}|#{window_name}' | awk -F'|' '$2=="boot"{print $1}' |
    while read -r w; do tmux kill-window -t "$w"; done
}

# Creates a worktree, prepares it from .workspace.yaml and opens its window through open_repo, so the
# window identity is the worktree path (@ws_repo) and a second call just selects the existing window.
worktree_cmd() { # $1=new|list|remove|merge ...
  local sub="${1:-}" path
  shift || true
  if [ "$sub" = new ]; then
    path="$(python3 "$SRC/worktrees.py" new "$@")" || exit $?
    [ -n "$path" ] && open_repo "$path"
  else
    python3 "$SRC/worktrees.py" "$sub" "$@"
  fi
}

side() { # $1=mode $2=window
  local pane
  pane="$(pane_with_role "$2" side)"
  [ -n "$pane" ] || return 0
  tmux set -w -t "$2" @ws_side "$1"
  tmux respawn-pane -k -t "$pane" "$(loop_cmd "$1")"
  # the strip only rereads the state (no respawn): it redraws the new active tab
  panel_signal "$2" dtabs
}

# Left-top panel mode (repos | sessions), next to REPOS in the rtabs strip.
left() { # $1=repos|sessions $2=window
  local pane
  pane="$(pane_with_role "$2" repos)"
  [ -n "$pane" ] || return 0
  tmux set -w -t "$2" @ws_left "$1"
  tmux respawn-pane -k -t "$pane" "$(loop_cmd "$1")"
  panel_signal "$2" rtabs
  return 0
}

# Opens the repo window and submits a message in its active Claude tab.
# $3=0 sends without leaving the current window (used by the tasks panel).
send_prompt() { # $1=repo path $2=message $3=focus (default 1)
  local path W pane S prev="" P i
  python3 "$SRC/lib.py" repo-enabled "$1" || return 1   # switched off: the message is refused, not queued
  [ "${3:-1}" = 0 ] && prev="$(tmux display -p '#{window_id}' 2>/dev/null)"
  open_repo "$1"
  path="$(readlink -f "${1/#\~/$HOME}")"; S="$(env_global WS_PROFILE)"
  W="$(tmux list-windows -t "$S:" -F '#{window_id}|#{@ws_repo}' | awk -F'|' -v p="$path" '$2==p {print $1; exit}')"
  [ -n "$W" ] || return 1
  if [ -z "$(tab_list "$W" s)" ]; then
    session_new "$W" "$(python3 "$SRC/lib.py" default-profile)" || return 1
    P="$(pane_with_role "$W" claude)"; i=0
    while [ -n "$(tmux show -pqv -t "$P" @ws_placeholder 2>/dev/null)" ] && [ "$i" -lt 50 ]; do
      sleep 0.1; i=$((i + 1))
    done
    sleep 0.5
  fi
  pane="$(tmux show -wqv -t "$W" @ws_active)"
  tab_alive "$pane" 2>/dev/null || pane="$(pane_with_role "$W" claude)"
  # Bracketed paste, not send-keys -l: a multi-line message (the conference prompt carries the log)
  # would otherwise press Enter on its first line break and submit before the end.
  tmux set-buffer -b ws_send -- "$2" && tmux paste-buffer -p -d -b ws_send -t "$pane" \
    && tmux send-keys -t "$pane" Enter
  [ -n "$prev" ] && tmux select-window -t "$prev"
}

# Types text into the active session tab of a window, without Enter (bracketed paste: newlines stay text), and focuses it.
type_prompt() { # $1=window id $2=text
  local W="$1" pane P i
  if [ -z "$(tab_list "$W" s)" ]; then
    session_new "$W" "$(python3 "$SRC/lib.py" default-profile)" || return 1
    P="$(pane_with_role "$W" claude)"; i=0
    while [ -n "$(tmux show -pqv -t "$P" @ws_placeholder 2>/dev/null)" ] && [ "$i" -lt 50 ]; do
      sleep 0.1; i=$((i + 1))
    done
    sleep 0.5
  fi
  pane="$(tmux show -wqv -t "$W" @ws_active)"
  tab_alive "$pane" 2>/dev/null || pane="$(pane_with_role "$W" claude)"
  [ -n "$pane" ] || return 1
  tmux set-buffer -b ws_prompt -- "$2" && tmux paste-buffer -p -d -b ws_prompt -t "$pane"
  tmux select-pane -t "$pane"
}

# --- Sessions (one per profile, tabs above the main pane) ----------------------------------------
# The main pane (role claude) is the slot; the first session runs there, the others live in hidden
# windows "tab:<repo>" and swap into the slot. @ws_tabs lists the live session panes, @ws_active the
# active one, @ws_next the next tab number, each pane carries its profile in @ws_tab_profile and the
# window keeps the active profile in @ws_session_profile.

# Persistent session tabs ($WS_STATE/tabs): one file per repo with the ordered tabs, each with its
# stable id and profile, plus `session-<tab>` where the hook/plugin write the real session id. The id
# is also the `WS_SESSION_TAB` of the session and travels in the pane option @ws_tab_id, so the state
# can be rebuilt from a live server before a `restart` kills it.
state_cmd() { python3 "$SRC/session_state.py" "$@"; }

tab_state_id() { # $1=pane: stable tab id, created the first time the pane is recorded
  local P="$1" id
  id="$(tmux show -pqv -t "$P" @ws_tab_id 2>/dev/null)"
  if [ -z "$id" ]; then
    id="$(state_cmd new-id)"
    tmux set -p -t "$P" @ws_tab_id "$id"
  fi
  printf '%s\n' "$id"
}

state_add_tab() { # $1=window $2=pane: records a live session tab (profile from the pane)
  local W="$1" P="$2" path id prof
  path="$(tmux show -wqv -t "$W" @ws_repo)"; [ -n "$path" ] || return 0
  id="$(tab_state_id "$P")"; [ -n "$id" ] || return 0
  prof="$(tmux show -pqv -t "$P" @ws_tab_profile)"
  state_cmd add "$path" "$id" "$prof" >/dev/null
}

state_active_tab() { # $1=window $2=pane
  local W="$1" P="$2" path id
  path="$(tmux show -wqv -t "$W" @ws_repo)"; [ -n "$path" ] || return 0
  id="$(tab_state_id "$P")"; [ -n "$id" ] || return 0
  state_cmd active "$path" "$id" >/dev/null
}

state_remove_tab() { # $1=window $2=pane
  local W="$1" P="$2" path id
  path="$(tmux show -wqv -t "$W" @ws_repo)"; [ -n "$path" ] || return 0
  id="$(tmux show -pqv -t "$P" @ws_tab_id 2>/dev/null)"; [ -n "$id" ] || return 0
  state_cmd remove "$path" "$id" >/dev/null
}

state_sync_window() { # $1=window: writes the live session tabs, in order, exactly as they are
  local W="$1" path active active_id p id prof
  path="$(tmux show -wqv -t "$W" @ws_repo)"; [ -n "$path" ] || return 0
  active="$(tmux show -wqv -t "$W" @ws_active)"
  active_id=""
  if [ -n "$active" ] && tab_alive "$active"; then active_id="$(tab_state_id "$active")"; fi
  {
    for p in $(tab_list "$W" s); do
      id="$(tab_state_id "$p")"
      prof="$(tmux show -pqv -t "$p" @ws_tab_profile)"
      printf '%s\t%s\n' "$id" "$prof"
    done
  } | state_cmd save "$path" "$active_id"
}

state_sync_profile() { # $1=profile: every open repo window (the caller points tmux at the server)
  local W path
  while IFS='|' read -r W path; do
    [ -n "$path" ] && state_sync_window "$W"
  done < <(tmux list-windows -t "$1:" -F '#{window_id}|#{@ws_repo}')
}

# Creates the tabs recorded for the repo, in order and with their own profile/id. Returns 1 when the
# repo has no recorded tab, so the caller can open the default profile only in that case.
session_restore() { # $1=window $2=repo path
  local W="$1" path="$2" active="" kind a b c p i
  local -a ids=() profiles=()
  # `list` prints `active<TAB>id` and `id<TAB>tab id<TAB>profile<TAB>session`; the session id
  # comes from session_for when the pane launches, so restoring only needs the tab id and profile.
  while IFS=$'\t' read -r kind a b c; do
    case "$kind" in
      active) active="$a" ;;
      id) ids+=("$a"); profiles+=("${b:-}") ;;
    esac
  done < <(state_cmd list "$path")
  [ "${#ids[@]}" -gt 0 ] || return 1
  for i in "${!ids[@]}"; do
    session_new "$W" "${profiles[$i]}" "${ids[$i]}" 1 || true
  done
  if [ -n "$active" ]; then
    for p in $(tab_list "$W" s); do
      if [ "$(tmux show -pqv -t "$p" @ws_tab_id)" = "$active" ]; then
        tab_show "$W" "$p"
        break
      fi
    done
  fi
  return 0
}

open_sessions() { # $1=window $2=repo path: restore the recorded tabs, else open the default profile
  session_restore "$1" "$2" || session_new "$1" "$(python3 "$SRC/lib.py" default-profile)"
}

session_menu() { # $1=window: blocking profile menu for a new session
  python3 "$SRC/session_menu.py" "$1"
}

risk_check() { # $1=window $2=profile $3=path
  local W="$1" profile="$2" path="$3" client status answer
  python3 "$SRC/session_risk.py" --check "$profile" >/dev/null 2>&1 || return 0
  client="$(tmux display -p '#{client_name}' 2>/dev/null)"
  if [ -z "$client" ]; then
    msg session.risk.no_client >&2
    return 1
  fi
  status="$(mktemp "${TMPDIR:-/tmp}/ws-risk.XXXXXX")" || return 1
  tmux display-popup -E -c "$client" -w 70% -h 40% -d "$path" \
    "python3 '$SRC/session_risk.py' --confirm '$profile' --status '$status'"
  answer="$(cat "$status" 2>/dev/null)"
  rm -f "$status"
  [ "$answer" = "yes" ]
}

session_new() { # $1=window $2=profile (default: the configured agent) $3=tab id $4=1 when restoring
  local W="$1" profile="${2:-}" path S n P tab="${3:-}" restore="${4:-}"
  path="$(tmux show -wqv -t "$W" @ws_repo)"
  [ -n "$path" ] || return 1
  python3 "$SRC/lib.py" repo-enabled "$path" || return 1   # switched off: no agent process
  S="$(env_global WS_PROFILE)"
  if [ -z "$profile" ]; then profile="$(python3 "$SRC/lib.py" default-profile)"; fi
  if ! python3 "$SRC/lib.py" profile-list | grep -qxF "$profile"; then
    msg session.unknown profile="$profile" >&2
    return 1
  fi
  # Restoring a recorded tab does not ask again: the person already accepted this profile.
  [ -n "$restore" ] || risk_check "$W" "$profile" "$path" || return 1
  [ -n "$tab" ] || tab="$(state_cmd new-id)"
  if [ -z "$(tab_list "$W" s)" ]; then
    # first session: it takes the main slot (the pane that showed the placeholder)
    P="$(pane_with_role "$W" claude)"
    [ -n "$P" ] || return 1
    tmux set -p -t "$P" @ws_tab_profile "$profile"
    tmux set -p -t "$P" @ws_tab_id "$tab"
    tmux set -pu -t "$P" @ws_placeholder
    tmux set -w -t "$W" @ws_tabs "$P"
    tmux set -w -t "$W" @ws_active "$P"
    tmux set -w -t "$W" @ws_session_profile "$profile"
    state_add_tab "$W" "$P"
    tmux respawn-pane -k -t "$P" -c "$path" "'$BIN/workspace' session-run '$W' ${profile@Q} ${path@Q} ${tab@Q}"
    tmux select-pane -t "$P"
  else
    # another session: a hidden window, swapped into the slot
    n="$(tmux show -wqv -t "$W" @ws_next)"; n="${n:-2}"
    P="$(tmux new-window -d -P -F '#{pane_id}' -t "$S:" -n "tab:$(basename "$path")" -c "$path")"
    tmux set -p -t "$P" @role "tmp $n"
    tmux set -p -t "$P" @ws_owner "$W"
    tmux set -p -t "$P" @ws_tab_profile "$profile"
    tmux set -p -t "$P" @ws_tab_id "$tab"
    tmux set -w -t "$W" @ws_tabs "$(tab_list "$W" s | tr '\n' ' ')$P"
    tmux set -w -t "$W" @ws_next $((n + 1))
    state_add_tab "$W" "$P"
    tab_show "$W" "$P"
    tmux respawn-pane -k -t "$P" -c "$path" "'$BIN/workspace' session-run '$W' ${profile@Q} ${path@Q} ${tab@Q}"
  fi
  tab_render "$W" s
  return 0
}

session_run() { # $1=window $2=profile $3=path $4=tab id: the agent process of one session pane
  local profile="$2" path="$3" tab="${4:-}" line started="$SECONDS"
  line="$(python3 "$SRC/lib.py" session-command "$profile" "$path" "$tab")"
  if [ -z "$line" ]; then
    msg session.unknown profile="$profile" >&2
    sleep 10
    "$BIN/workspace" session-exit "$TMUX_PANE" 0
    return 0
  fi
  cd "$path"
  sh -c "$line"
  "$BIN/workspace" session-exit "$TMUX_PANE" "$((SECONDS - started))"
}

session_exit() { # $1=pane of a session that ended $2=how many seconds it stayed alive (optional)
  local P="$1" alive="${2:-}" W role first active prof profile path
  W="$(tmux show -pqv -t "$P" @ws_owner 2>/dev/null)"
  [ -n "$W" ] || W="$(tmux display -p -t "$P" '#{window_id}')"
  [ -n "$W" ] || return 0
  path="$(tmux show -wqv -t "$W" @ws_repo)"
  role="$(tmux show -pqv -t "$P" @role)"
  profile="$(tmux show -pqv -t "$P" @ws_tab_profile)"
  tmux set -w -t "$W" @ws_tabs "$(tab_list "$W" s | grep -vxF "$P" | tr '\n' ' ')"
  state_remove_tab "$W" "$P"
  if [ "$role" = claude ]; then
    # the session in the main slot ended
    tmux set -p -t "$P" @ws_placeholder 1   # mark first: tab_list must not re-adopt this pane
    first="$(tab_list "$W" s | head -1)"
    if [ -n "$first" ]; then
      tab_show "$W" "$first"   # promote the next session; P stays hidden, its process is done
    else
      tmux set -w -t "$W" @ws_active ""
      tmux set -w -t "$W" @ws_session_profile ""
      tmux set -w -t "$W" @ws_mview session
      tmux set -p -t "$P" @role claude
      tmux set -p -t "$P" @ws_placeholder 1
      tmux select-pane -t "$P"
      tab_render "$W" s
      # The last tab opened a new default one, so the strip never stays empty on purpose. If that
      # fails (unknown profile, cancelled risk prompt), the placeholder is the fallback.
      [ -n "$path" ] && state_sync_window "$W"
      # A session that ends right after launch (bad settings, missing binary) must not relaunch the
      # default profile: that would loop every few seconds. Say why and leave the placeholder.
      if [ -n "$alive" ] && [ "$alive" -lt "$SESSION_MIN_SECONDS" ] 2>/dev/null; then
        tmux display-message "$(msg session.failed_fast profile="$profile")" 2>/dev/null || true
      elif [ -n "$path" ] && session_new "$W" "$(python3 "$SRC/lib.py" default-profile)"; then
        return 0
      fi
      # last: replace this pane with the placeholder (kills this shell, so nothing may run after)
      tmux respawn-pane -k -t "$P" -c "$path" "python3 '$SRC/session_placeholder.py'"
      return 0
    fi
  else
    # a hidden session ended: normally just remove it (the active one is always in the slot)
    active="$(tmux show -wqv -t "$W" @ws_active)"
    if [ "$active" = "$P" ]; then
      first="$(tab_list "$W" s | head -1)"
      if [ -n "$first" ]; then
        tab_show "$W" "$first"
      else
        tmux set -w -t "$W" @ws_active ""
        tmux set -w -t "$W" @ws_session_profile ""
        tmux set -w -t "$W" @ws_mview session
      fi
    fi
  fi
  active="$(tmux show -wqv -t "$W" @ws_active)"
  prof=""
  if [ -n "$active" ] && tab_alive "$active"; then
    prof="$(tmux show -pqv -t "$active" @ws_tab_profile)"
  fi
  tmux set -w -t "$W" @ws_session_profile "$prof"
  [ -n "$path" ] && state_sync_window "$W"
  tab_render "$W" s
}

# Closes windows (and their hidden tab windows) whose repo is no longer in config.yaml.
# Runs on reload, so removing a repo from settings cleans up the rest.
prune() { # $1=session
  local names id name base
  names="$(python3 "$SRC/lib.py" window-names "$1")"
  [ -n "$names" ] || return 0   # unreadable/empty settings: never prune
  while IFS='|' read -r id name; do
    [ "$name" = boot ] && continue
    base="${name#tab:}"; base="${base#ttab:}"
    grep -qxF -- "$base" <<<"$names" || tmux kill-window -t "$id" 2>/dev/null
  done < <(tmux list-windows -t "$1:" -F '#{window_id}|#{window_name}')
  return 0
}

# Lifecycle (src/lifecycle.py names the servers and their profiles; this file starts and kills them).
# Every command acts on one profile's server at a time: the argument (a profile or its ws-* server),
# or every live server when there is none.

profile_up() { env -u TMUX tmux -L "ws-$1" has-session -t "$1" 2>/dev/null; }

# Saves the live session tabs of a profile's server (id, profile, order, active one), then kills the
# server. Used by restart and stop: opening the server again brings the saved tabs back.
server_down() { # $1=profile
  local profile="$1" old_tmux="${TMUX-}"
  if profile_up "$profile"; then
    export TMUX="$(env -u TMUX tmux -L "ws-$profile" display -p '#{socket_path},#{pid},0')"
    export WS_PROFILE="$profile"
    state_sync_profile "$profile"
  fi
  env -u TMUX tmux -L "ws-$profile" kill-server 2>/dev/null
  if [ -n "$old_tmux" ]; then export TMUX="$old_tmux"; else unset TMUX; fi
}

# Kills the server and starts it again. New hooks/config only take effect this way: detach is not
# enough, Claude reads the hooks on open.
restart_one() { # $1=profile
  local profile="$1"
  if profile_up "$profile"; then server_down "$profile"; sleep 1; fi
  start_workspace "$profile"
}

# Runs `fn <profile>` for each profile the argument names (lifecycle.py resolves a profile or a ws-*
# server). Without an argument: every live server; none alive: the default claude (so `restart` still
# starts it and `reload` keeps its "no workspace" message). Several servers stay detached.
lifecycle_each() { # $1=function $2=optional argument
  local fn="$1" arg="${2:-}" p
  local -a targets=()
  while IFS= read -r p; do [ -n "$p" ] && targets+=("$p"); done < <(python3 "$SRC/lifecycle.py" profiles "$arg")
  if [ "${#targets[@]}" -eq 0 ]; then
    [ -n "$arg" ] && { msg cli.unknown_profile profile="$arg" >&2; return 2; }
    targets=(claude)
  fi
  [ "${#targets[@]}" -gt 1 ] && export WS_NO_ATTACH=1
  for p in "${targets[@]}"; do "$fn" "$p"; done
}

# Restarts the panels (repos, side column, tab strip), re-reading the code: kills each python
# and the `while :` loop starts it again in ~1s. Does not touch Claude or the terminal.
panels() { # $1=profile (default: claude)
  local profile="${1:-claude}" sock="ws-${1:-claude}" pid
  tmux -L "$sock" has-session -t "$profile" 2>/dev/null || { msg cli.no_workspace profile="$profile" >&2; exit 1; }
  while read -r pid; do
    pkill -TERM -P "$pid" -f 'python3 .*/panel_' 2>/dev/null
  done < <(tmux -L "$sock" list-panes -a -F '#{pane_pid}|#{@role}' | awk -F'|' '$2=="repos"||$2=="tasks"||$2=="side"||$2=="tabs"||$2=="ttabs"||$2=="dtabs"||$2=="rtabs"||$2=="ktabs"{print $1}')
  return 0
}

# --- Phone layout --------------------------------------------------------------------------------
# On a narrow window (portrait phone) the window shows ONE pane at a time (tmux zoom): Claude by default,
# and the hamburger menu (status bar, or ctrl+b m) picks the view. State: window option @ws_mview, which
# layout_apply turns into the zoom (the only place that zooms).

mview_target() { # $1=window $2=session|claude|terminal|repos|tasks|side -> pane id
  local W="$1" p=""
  case "$2" in
    session|claude) p="$(tmux show -wqv -t "$W" @ws_active)"; tab_alive "$p" 2>/dev/null || p="$(pane_with_role "$W" claude)" ;;
    terminal) p="$(tmux show -wqv -t "$W" @ws_term_active)"; tab_alive "$p" 2>/dev/null || p="$(pane_with_role "$W" terminal)" ;;
    repos) p="$(pane_with_role "$W" repos)" ;;
    tasks) p="$(pane_with_role "$W" tasks)" ;;
    side) p="$(pane_with_role "$W" side)" ;;
  esac
  echo "$p"
}

mview() { # $1=window $2=view $3=optional mode (repos: repos|sessions, side: tree|diff|github)
  local W="$1" view="$2"
  [ "$view" = claude ] && view=session
  case "$view" in
    repos) [ -n "${3:-}" ] && left "$3" "$W" ;;
    side) [ -n "${3:-}" ] && side "$3" "$W" ;;
  esac
  tmux set -w -t "$W" @ws_mview "$view"
  # the target view changed: this is the only session-facing entry that reapplies the layout
  layout_apply "$W"
  return 0
}

# Hamburger menu (labels are the @t_menu_* i18n options, expanded by tmux).
menu() { # $1=client $2=window
  local C="$1" W="$2" w="$BIN/workspace"
  tmux display-menu -c "$C" -T '#{@t_menu_title}' -x C -y C \
    '#{@t_menu_claude}' c "run-shell -b \"$w mview $W session\"" \
    '#{@t_menu_terminal}' t "run-shell -b \"$w mview $W terminal\"" \
    '' \
    '#{@t_menu_repos}' r "run-shell -b \"$w mview $W repos repos\"" \
    '#{@t_menu_sessions}' s "run-shell -b \"$w mview $W repos sessions\"" \
    '#{@t_menu_tasks}' k "run-shell -b \"$w mview $W tasks\"" \
    '#{@t_menu_tree}' f "run-shell -b \"$w mview $W side tree\"" \
    '#{@t_menu_diff}' d "run-shell -b \"$w mview $W side diff\"" \
    '#{@t_menu_github}' g "run-shell -b \"$w mview $W side github\"" \
    '' \
    '#{@t_menu_tab_new}' n "run-shell -b \"$w session-menu $W\"" \
    '#{@t_menu_tab_next}' p "run-shell -b \"$w tab-step $W 1 session\"" \
    '#{@t_menu_tterm_new}' N "run-shell -b \"$w tab-new $W terminal\"" \
    '#{@t_menu_tterm_next}' P "run-shell -b \"$w tab-step $W 1 terminal\""
}

# --- Layout (single owner of the geometry) ------------------------------------------------------
# Every pane size, the phone zoom and the client refresh happen here and nowhere else: side column
# widths, terminal height, strip heights and the mobile view. The tmux hooks call `fit` on every
# client event, so this compares the current geometry with the target and emits NO tmux command at
# all when they are equal (a repeated client-active/client-focus-in redraws nothing).
layout_pane() { # $1=list-panes dump $2=role -> pane_id|width|height|active
  awk -F'|' -v r="$2" '$2==r{print $1"|"$3"|"$4"|"$5; exit}' <<<"$1"
}

layout_value() { # $1=list-panes dump $2=role $3=field (1 id, 2 width, 3 height, 4 active)
  layout_pane "$1" "$2" | cut -d'|' -f"$3"
}

layout_apply() { # $1=window $2=redraw (non-empty: reload; every client is redrawn in full, even with no geometry change)
  local W="$1" redraw="${2:-}" rows w h zoomed view target active cmd=() c
  local role flag value cur id pw ph
  local claude_p term_p ttabs_p term_h ttabs_h delta term_target
  rows="$(tmux list-panes -t "$W" -F '#{pane_id}|#{@role}|#{pane_width}|#{pane_height}|#{pane_active}|#{window_width}|#{window_height}|#{window_zoomed_flag}')"
  [ -n "$rows" ] || return 0
  claude_p="$(layout_value "$rows" claude 1)"
  [ -n "$claude_p" ] || return 0
  IFS='|' read -r _ _ _ _ _ w h zoomed <<<"${rows%%$'\n'*}"
  # Leaving the phone: a zoomed pane reports its zoomed (full-window) size, so the target comparison
  # below would be wrong. Undo our zoom first, then reread the real (unzoomed) geometry. This happens
  # once on the transition; later desktop events are silent.
  if [ "$w" -ge "$MOBILE_W" ] && [ "$(tmux show -wqv -t "$W" @ws_mzoom)" = 1 ]; then
    [ "$zoomed" = 1 ] && tmux resize-pane -Z -t "$W"
    tmux set -wu -t "$W" @ws_mzoom
    rows="$(tmux list-panes -t "$W" -F '#{pane_id}|#{@role}|#{pane_width}|#{pane_height}|#{pane_active}|#{window_width}|#{window_height}|#{window_zoomed_flag}')"
    [ -n "$rows" ] || return 0
    claude_p="$(layout_value "$rows" claude 1)"
    [ -n "$claude_p" ] || return 0
    IFS='|' read -r _ _ _ _ _ w h zoomed <<<"${rows%%$'\n'*}"
  fi
  # A zoomed (phone) window keeps one view: resizing its hidden panes fails, so only the zoom applies.
  if [ "$w" -ge "$MOBILE_W" ]; then
    while IFS='|' read -r role flag value; do
      [ -n "$role" ] || continue
      cur="$(layout_pane "$rows" "$role")"; [ -n "$cur" ] || continue
      id="${cur%%|*}"; cur="${cur#*|}"; pw="${cur%%|*}"; cur="${cur#*|}"; ph="${cur%%|*}"
      case "$flag" in
        x) [ "$pw" = "$value" ] && continue ;;
        y) [ "$ph" = "$value" ] && continue ;;
      esac
      cmd+=(resize-pane -t "$id" "-$flag" "$value" ';')
    done <<EOF
repos|x|$(col_w left "$w")
side|x|$(col_w right "$w")
tabs|y|2
rtabs|y|2
ktabs|y|1
dtabs|y|2
EOF
    # The terminal and its strip share one container, so resizing them directly only moves the line
    # between them; the container total belongs to the main pane. Fix it there (relative, so the exact
    # border lines do not matter), then put the strip back and the terminal lands on its target.
    term_target=$(( (h - 2) * 17 / 100 ))
    term_p="$(layout_value "$rows" terminal 1)"
    ttabs_p="$(layout_value "$rows" ttabs 1)"
    if [ -n "$term_p" ] && [ -n "$ttabs_p" ]; then
      term_h="$(layout_value "$rows" terminal 3)"
      ttabs_h="$(layout_value "$rows" ttabs 3)"
      delta=$(( ttabs_h + term_h + 1 - (term_target + 2) ))
      if [ "$delta" -gt 0 ]; then
        cmd+=(resize-pane -t "$claude_p" -D "$delta" ';')
      elif [ "$delta" -lt 0 ]; then
        cmd+=(resize-pane -t "$claude_p" -U "$((-delta))" ';')
      fi
      [ $((ttabs_h - delta)) -ne 1 ] && cmd+=(resize-pane -t "$ttabs_p" -y 1 ';')
    elif [ -n "$term_p" ] && [ "$(layout_value "$rows" terminal 3)" != "$term_target" ]; then
      cmd+=(resize-pane -t "$term_p" -y "$term_target" ';')
    elif [ -n "$ttabs_p" ] && [ "$(layout_value "$rows" ttabs 3)" != 1 ]; then
      cmd+=(resize-pane -t "$ttabs_p" -y 1 ';')
    fi
  fi
  if [ -z "$(tmux show -wqv -t "$W" @ws_repo)" ]; then
    # plugin windows: only the bar is ours, and they never get the phone zoom
    if [ -n "$redraw" ]; then
      while read -r c; do cmd+=(refresh-client -t "$c" ';'); done < <(tmux list-clients -F '#{client_name}')
    fi
    [ "${#cmd[@]}" -gt 0 ] && tmux "${cmd[@]}" refresh-client 2>/dev/null
    return 0
  fi
  if [ "$w" -lt "$MOBILE_W" ]; then
    view="$(tmux show -wqv -t "$W" @ws_mview)"; view="${view:-session}"
    target="$(mview_target "$W" "$view")"
    active="$(awk -F'|' '$5==1{print $1; exit}' <<<"$rows")"
    [ -n "$target" ] || target="$active"
    [ "$(tmux show -wqv -t "$W" @ws_mzoom)" = 1 ] || cmd+=(set -w -t "$W" @ws_mzoom 1 ';')
    if [ "$zoomed" != 1 ]; then
      # not zoomed (fresh window or the person unzoomed): show the target view alone
      cmd+=(select-pane -t "$target" ';' resize-pane -Z -t "$target" ';')
    elif [ "$target" != "$active" ]; then
      cmd+=(select-pane -Z -t "$target" ';')   # already zoomed: move the zoom to the new view
    fi
  fi
  if [ -n "$redraw" ]; then
    while read -r c; do cmd+=(refresh-client -t "$c" ';'); done < <(tmux list-clients -F '#{client_name}')
  fi
  [ "${#cmd[@]}" -gt 0 ] && tmux "${cmd[@]}" refresh-client 2>/dev/null
  return 0
}

# Plugin windows: the plugins listed in config.yaml ("plugins" per profile), one window "plugin:<id>" each.
# Nothing is discovered (see src/lib.py). lib.py checks plugin.json and prints only the valid ones, so a
# broken plugin shows its error here and the other windows are still built.
# Mode bar on top of every plugin window (full width, above the plugin's own layout): the rtabs strip
# of panel_tabs.py, which lists REPOS and the plugins. The plugin owns its layout, so the bar is added here.
BARRA_PLUGIN='rtabs|claude|vb|2|tabs:repos'

plugin_open() { # $1=profile $2=id $3=folder $4=label $5=tree (see REPO_TREE)
  local S="$1" name="plugin:$2" W
  W="$(tmux list-windows -t "$S:" -F '#{window_id}|#{window_name}' | awk -F'|' -v n="$name" '$2==n{print $1; exit}')"
  if [ -z "$W" ]; then
    W="$(tmux new-window -d -P -F '#{window_id}' -t "$S:" -n "$name" -c "$3")"
    tmux set -p -t "$(tmux display -p -t "$W" '#{pane_id}')" @role claude
  fi
  # the bar comes first, so it takes the top row; ensure_window creates it only when missing
  ensure_window "$W" "$3" "$BARRA_PLUGIN"$'\n'"$5"
  msg plugin.opened label="$4" id="$2"
}

plugin_sync() { # $1=profile: opens or completes the window of each listed plugin (idempotent)
  local S="${1:-claude}" block="" id="" dir="" label="" line
  while IFS= read -r line; do
    if [[ "$line" == @@* ]]; then
      [ -n "$id" ] && plugin_open "$S" "$id" "$dir" "$label" "$block"
      IFS=$'\t' read -r id dir label <<<"${line#@@}"
      block=""
    else
      block+="$line"$'\n'
    fi
  done < <(python3 "$SRC/lib.py" plugins "$S")
  [ -n "$id" ] && plugin_open "$S" "$id" "$dir" "$label" "$block"
  return 0
}

# Checks an open window and creates what is missing (tab strips, repos, side, terminal) without touching
# what exists. New structural changes go in REPO_TREE, and `reload` applies them without a restart.
# $3 = pane tree (default REPO_TREE; plugins pass their own). Plugin windows have no @ws_repo.
ensure_window() { # $1=window $2=repo path $3=tree
  local W="$1" path="$2" P T active prof
  P="$(pane_with_role "$W" claude)"; [ -n "$P" ] || return 0
  init_tabs "$W" "$P" s
  build_tree "$W" "$path" "${3-$REPO_TREE}"
  tab_list "$W" s >/dev/null        # adopt a legacy window's main pane as a session
  active="$(tmux show -wqv -t "$W" @ws_active)"
  prof=""
  if [ -n "$active" ]; then prof="$(tmux show -pqv -t "$active" @ws_tab_profile)"; fi
  tmux set -w -t "$W" @ws_session_profile "$prof"
  T="$(pane_with_role "$W" terminal)"
  [ -n "$T" ] && init_tabs "$W" "$T" t
  [ -n "$(tmux show -wqv -t "$W" @ws_repo)" ] && state_sync_window "$W"
  layout_apply "$W"
  shells_start "$path"
}

# Light subcommand: re-applies the layout of every window of the profile (no panel restart). Many
# events arrive at once when the active client changes (client-active, resized, focus), so only one
# fit runs at a time; layout_apply already no-ops when the geometry did not change.
fit() {
  local profile="${1:-claude}" sock="ws-${1:-claude}" W   # lock stays global: the EXIT trap uses it
  # The lock comes before any tmux call: a burst of hooks must not open one connection to the server
  # each (a stuck server would pile up processes and fds). Everyone but the holder exits untouched.
  lock="${TMPDIR:-/tmp}/ws-fit-$profile-$(id -u)"
  if ! mkdir "$lock" 2>/dev/null; then
    # stale lock (the previous fit died before its EXIT trap): drop it and try the mkdir once more
    if [ -f "$lock/pid" ] && ! kill -0 "$(cat "$lock/pid")" 2>/dev/null; then
      rm -rf "$lock"
      mkdir "$lock" 2>/dev/null || return 0
    else
      return 0
    fi
  fi
  trap 'rm -rf "$lock"' EXIT
  echo $$ >"$lock/pid"
  tmux -L "$sock" has-session -t "$profile" 2>/dev/null || return 0
  export TMUX="$(tmux -L "$sock" display -p '#{socket_path},#{pid},0')"
  export WS_PROFILE="$profile"
  while read -r W; do layout_apply "$W"; done < <(tmux list-windows -t "$profile:" -F '#{window_id}')
}

# Applies a new config/tmux.conf and the tab strip to the windows already open, without killing the server.
reload() {
  local profile="${1:-claude}" sock="ws-${1:-claude}" W path
  tmux -L "$sock" has-session -t "$profile" 2>/dev/null || { msg cli.no_workspace profile="$profile" >&2; exit 1; }
  export TMUX="$(tmux -L "$sock" display -p '#{socket_path},#{pid},0')"
  export WS_PROFILE="$profile"
  settings_refresh_all
  tmux source-file "$ROOT/config/tmux.conf"
  prune "$profile"
  while IFS='|' read -r W path; do
    [ -n "$path" ] && ensure_window "$W" "$path"
  done < <(tmux list-windows -t "$profile:" -F '#{window_id}|#{@ws_repo}')
  plugin_sync "$profile"
  panels "$profile"
  # layout_apply is the only owner of the redraw: it refreshes every client once the windows are settled
  while read -r W; do layout_apply "$W" redraw; done < <(tmux list-windows -t "$profile:" -F '#{window_id}')
  doctor --warn >&2 || true   # drift warning: never fails the reload
  msg cli.reloaded profile="$profile"
}

start_workspace() {
  local profile="${1:-claude}" cmd sock first_repo
  cmd="$(profile_cmd "$profile")" || exit 2
  [ -n "$cmd" ] || { msg cli.unknown_profile profile="$profile" >&2; exit 2; }
  sock="ws-$profile"
  if ! env -u TMUX tmux -L "$sock" has-session -t "$profile" 2>/dev/null; then
    export WS_PROFILE="$profile"
    env -u TMUX tmux -L "$sock" -f "$ROOT/config/tmux.conf" new-session -d -s "$profile" -n boot \
      -x "${WS_COLS:-$(tput cols 2>/dev/null || echo 200)}" -y "${WS_LINES:-$(tput lines 2>/dev/null || echo 50)}"
    env -u TMUX tmux -L "$sock" set-environment -g WS_PROFILE "$profile"
    env -u TMUX tmux -L "$sock" set-environment -g WS_DIR "$ROOT"
    if [ "$(env -u TMUX tmux -L "$sock" list-windows -t "$profile:" -F '#{window_name}' | grep -vc '^boot$')" -eq 0 ]; then
      first_repo="$(python3 "$SRC/lib.py" initial-repo)"
      env -u TMUX tmux -L "$sock" run-shell "$BIN/workspace open '$first_repo'"
    fi
    env -u TMUX tmux -L "$sock" run-shell "$BIN/workspace plugins-sync '$profile'"
  fi
  [ -n "${WS_NO_ATTACH:-}" ] && return 0
  exec env -u TMUX tmux -L "$sock" attach -t "$profile"
}

install() {
  mkdir -p "$HOME/.local/bin"
  ln -sf "$BIN/workspace" "$HOME/.local/bin/workspace"
  msg cli.installed
}

# Item 75: only the clone the curl install made (INSTALL_DIR, default app/) is updated, and only by a
# fast-forward. A dev checkout (this file running from anywhere else) is refused: its owner pulls it.
update_workspace() {
  local app here
  app="$(readlink -f "${AT_WS_INSTALL_DIR:-$HOME/.local/share/ai-tmux-workspace/app}" 2>/dev/null)"
  here="$(readlink -f "$ROOT")"
  if [ -z "$app" ] || [ "$here" != "$app" ]; then
    msg cli.update.dev root="$ROOT" >&2
    return 1
  fi
  if [ ! -d "$ROOT/.git" ]; then
    msg cli.update.not_git root="$ROOT" >&2
    return 1
  fi
  if [ -n "$(git -C "$ROOT" status --porcelain 2>/dev/null)" ]; then
    msg cli.update.dirty root="$ROOT" >&2
    return 1
  fi
  if git -C "$ROOT" pull --ff-only; then
    msg cli.update.done
  else
    msg cli.update.failed >&2
    return 1
  fi
}

install_hooks() {
  python3 - "$SRC/hook.py" "$SRC/statusline.py" "$SRC" <<'PY'
import json, os, shutil, sys
from pathlib import Path

hook, statusline, src = sys.argv[1], sys.argv[2], sys.argv[3]
sys.path.insert(0, src)
from i18n import t

# Events confirmed in the Claude Code 2.1.319 binary. Third-party hooks are never touched.
EVENTS = ("SessionStart", "UserPromptSubmit", "PreToolUse", "PostToolUse", "PostToolUseFailure",
          "PermissionRequest", "PermissionDenied", "Notification", "Stop", "StopFailure",
          "SubagentStart", "SubagentStop", "SessionEnd", "Elicitation", "CwdChanged", "PostModelSwitch")

f = Path.home() / ".claude" / "settings.json"   # HOME overrides this, e.g. for tests
raw = f.read_text() if f.exists() else ""
try:
    cfg = json.loads(raw) if raw.strip() else {}
except json.JSONDecodeError as e:
    sys.exit(t("workspace.hooks.invalid_json", error=e))
if not isinstance(cfg, dict):
    sys.exit(t("workspace.hooks.not_object"))

changed = []
hooks = cfg.setdefault("hooks", {})
for ev in EVENTS:
    groups = hooks.setdefault(ev, [])
    if any(hook in h.get("command", "") for g in groups for h in g.get("hooks", [])):
        continue
    groups.append({"hooks": [{"type": "command", "command": f"python3 {hook}", "timeout": 5}]})
    changed.append(ev)

sl = cfg.get("statusLine")
if sl is None:
    cfg["statusLine"] = {"type": "command", "command": f"python3 {statusline}"}
    changed.append("statusLine")
    warning = None
elif isinstance(sl, dict) and statusline in str(sl.get("command", "")):
    warning = None
else:
    warning = t("workspace.hooks.statusline_warning")

if changed:
    if f.exists():
        shutil.copy(f, f.with_suffix(".json.bak-workspace"))
    f.parent.mkdir(parents=True, exist_ok=True)
    tmp = f.with_name(f.name + ".tmp-workspace")
    tmp.write_text(json.dumps(cfg, indent=2, ensure_ascii=False) + "\n")
    if f.exists():
        shutil.copymode(f, tmp)
    os.replace(tmp, f)

if warning:
    print(warning)
events = [c for c in changed if c != "statusLine"]
status = t("workspace.hooks.status_registered" if "statusLine" in changed
           else "workspace.hooks.status_unchanged")
rest = t("workspace.hooks.nothing")
if changed:
    rest = t("workspace.hooks.backup") if raw else ""
    rest += t("workspace.hooks.restart")
print(t("workspace.hooks.summary", events=len(events), status=status, rest=rest))
PY
}

# Opens the window of the workspace's own code (root = ROOT, role `self`, see src/session.py). It is not in
# config.yaml on purpose: `reload` keeps it because prune reads its name from `window-names` (src/lib.py).
dev_open() { # $1=profile (default claude)
  local profile="${1:-claude}" sock="ws-${1:-claude}"
  env -u TMUX tmux -L "$sock" has-session -t "$profile" 2>/dev/null || { msg cli.no_workspace profile="$profile" >&2; exit 1; }
  env -u TMUX tmux -L "$sock" run-shell "$BIN/workspace open '$ROOT'"
  [ -n "${WS_NO_ATTACH:-}" ] && return 0
  exec env -u TMUX tmux -L "$sock" attach -t "$profile"
}

case "${1:-}" in
  open) shift; open_repo "$@" ;;
  dev) shift; dev_open "$@" ;;
  side) shift; side "$@" ;;
  worktree) shift; worktree_cmd "$@" ;;
  left) shift; left "$@" ;;
  send) send_prompt "$2" "$3" "${4:-1}" ;;
  request) shift; python3 "$SRC/conference.py" request "$@" ;;
  type) type_prompt "$2" "$3" ;;
  options) tmux display-popup -c "$2" -E -w 80% -h 70% -d "$ROOT" "python3 $SRC/options.py $3" ;;
  session-menu) session_menu "$2" ;;
  session-new) session_new "$2" "${3:-}" ;;
  session-run) session_run "$2" "$3" "$4" "${5:-}" ;;
  session-exit) session_exit "$2" "${3:-}" ;;
  tab-new) tab_new "$2" "${3:-}" ;;
  tab-show) tab_show "$2" "$3" ;;
  tab-step) tab_step "$2" "$3" "${4:-}" ;;
  tab-exit) tab_exit "$2" ;;
  plugins-sync) plugin_sync "${2:-claude}" ;;
  install) install ;;
  update) update_workspace ;;
  -h|--help) msg cli.help ;;
  install-hooks) install_hooks ;;
  privileged) shift; python3 "$SRC/installer.py" --privileged "$@" ;;
  doctor) shift; doctor "$@" ;;
  config) shift; python3 "$SRC/config_cmd.py" "$@" ;;
  stop) shift; lifecycle_each server_down "${1:-}" ;;
  restart) shift; lifecycle_each restart_one "${1:-}" ;;
  reload) shift; lifecycle_each reload "${1:-}" ;;
  repo) shift; python3 "$SRC/lib.py" repo "$@" ;;
  fit) shift; fit "$@" ;;
  mview) shift; mview "$@" ;;
  view) shift; python3 "$SRC/opener.py" "$@" ;;
  menu) menu "$2" "$3" ;;
  ""|-*) start_workspace claude ;;
  *) msg cli.unknown_command command="$1" >&2; exit 2 ;;
esac
