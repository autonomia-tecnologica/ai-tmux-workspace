#!/usr/bin/env bash
# workspace — tmux para os repos de settings.json (~/.config/ai-tmux-workspace/).
#   workspace                 abre (ou reanexa) o workspace; o agente (claude, deepseek...) vem de "agent" no settings.json (Ctrl+b o)
#   workspace install         links `workspace` into ~/.local/bin
#   workspace install-hooks   registers the Claude Code hooks that light the dots
#   workspace restart [perfil] kill the tmux server and start again (Claude resumes with --continue)
#   workspace fit [perfil]    re-apply only the pane sizes (run by the tmux hooks on attach/resize)
#   workspace reload [perfil] reload tmux.conf, restart the panels (picks up code changes) and add the tab strip to open windows (no restart)
#   workspace stop [perfil]   kill the profile's tmux server
# Internal (called from inside tmux): open <repo> · side <tree|diff|github> · left <repos|sessions> · resume
#   tab-new|tab-show|tab-step|tab-exit  (temporary Claude tabs next to the main one) · plugins-sync <perfil>
set -u
BIN="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
AQUI="$(dirname "$BIN")"        # raiz do repo
SRC="$AQUI/src"
export WS_DIR="$AQUI"
MOBILE_W=100   # windows narrower than this (columns) use the phone layout: one zoomed view + hamburger menu

msg() { python3 "$SRC/i18n.py" "$@"; }   # i18n text: msg <key> [name=value ...]
perfil_cmd() { python3 "$SRC/lib.py" perfil-cmd "$1"; }
env_global() { tmux show-environment -g "$1" 2>/dev/null | cut -d= -f2-; }
laco() { # $1 = repos | tasks | tree | sessions | diff | github | tabs [claude|terminal]
  printf 'while :; do python3 %q %s; sleep 1; done' "$SRC/panel_$1.py" "${2:-}"
}

# Side column widths: a share of the window, clamped so they stay usable on small and ultrawide screens.
col_w() { # $1=left|right  $2=window width
  local pct min max w
  case "$1" in left) pct=22 min=28 max=44;; *) pct=19 min=24 max=44;; esac
  [ "$2" -lt "$MOBILE_W" ] && min=8   # phone: side panes are never seen side by side (zoomed one at a time)
  w=$(( $2 * pct / 100 )); [ "$w" -lt "$min" ] && w=$min; [ "$w" -gt "$max" ] && w=$max
  echo "$w"
}
# Terminal height: 17% of the Claude pane plus the 1 line the terminal tab strip takes back.
term_h() { echo $(( ($(tmux display -p -t "$1" '#{window_height}') - 2) * 17 / 100 + 1 )); }

# Repo pane tree, in creation order (the order decides how much room each split takes).
# One line per pane: role|parent|split|size|command. The claude pane is the window itself (not in the tree).
#   split: v (stacked) | h (side by side); b = before the parent; f = full (window height/width)
#   size: lines, N%, or TERM / LEFT / RIGHT (computed at build time); empty = half of the parent
#   command: shell (plain shell, restarted at its final size), laco:<panel>, tabs:<strip>
REPO_TREE='tabs|claude|vb|2|tabs:claude
terminal|claude|v|TERM|shell
ttabs|terminal|vb|1|tabs:terminal
repos|claude|hbf|LEFT|laco:repos
tasks|repos|v|50%|laco:tasks
rtabs|repos|vb|2|tabs:repos
ktabs|tasks|vb|1|tabs:tasks
direita|claude|hf|RIGHT|laco:tree
dtabs|direita|vb|2|tabs:side'

# Pane with a given role in a window. "terminal" also matches the temporary "ttmp N" tab standing in for it.
pane_with_role() { # $1=janela $2=papel
  tmux list-panes -t "$1" -F '#{pane_id}|#{@papel}' |
    awk -F'|' -v r="$2" '$2==r || (r=="terminal" && $2 ~ /^ttmp /){print $1; exit}'
}

# Creates, in tree order, the panes the window lacks (a role already present is skipped, and so is a missing parent).
# Does not apply the final sizes: the caller decides (construir does not, ensure_window calls fit_window).
build_tree() { # $1=janela $2=caminho do repo $3=árvore (ver REPO_TREE)
  local W="$1" path="$2" tree="$3" role parent split size cmd anchor P larg id dir sh shells=""
  local opts hfix=""
  P="$(pane_with_role "$W" claude)"; [ -n "$P" ] || return 0
  larg="$(tmux display -p -t "$W" '#{window_width}')"
  while IFS='|' read -r role parent split size cmd; do
    case "$role" in ''|\#*) continue ;; esac
    [ -n "$(pane_with_role "$W" "$role")" ] && continue
    anchor="$(pane_with_role "$W" "$parent")"; [ -n "$anchor" ] || continue
    case "$size" in
      TERM) size="$(term_h "$P")" ;;
      LEFT) size="$(col_w left "$larg")" ;;
      RIGHT) size="$(col_w right "$larg")" ;;
    esac
    dir=-v; case "$split" in h*) dir=-h ;; esac
    opts=(-d "$dir")
    case "$split" in *b*) opts+=(-b) ;; esac
    case "$split" in *f*) opts+=(-f) ;; esac
    [ -n "$size" ] && opts+=(-l "$size")
    sh=""
    case "$cmd" in laco:*) sh="$(laco "${cmd#laco:}")" ;; tabs:*) sh="$(laco tabs "${cmd#tabs:}")" ;; esac
    if [ -n "$sh" ]; then
      id="$(tmux split-window "${opts[@]}" -t "$anchor" -c "$path" -P -F '#{pane_id}' "$sh")"
    else
      id="$(tmux split-window "${opts[@]}" -t "$anchor" -c "$path" -P -F '#{pane_id}')"
    fi
    tmux set -p -t "$id" @papel "$role"
    case "$split" in h*) [ -n "$size" ] && hfix="$hfix $id:$size" ;; esac
    [ "$cmd" = shell ] && shells="$shells $id"
  done <<<"$tree"
  # side columns get their exact width once all splits exist (a later split can shrink them)
  for x in $hfix; do tmux resize-pane -t "${x%%:*}" -x "${x#*:}"; done
  # shell panes start only now, at their final size (no stray "%")
  for id in $shells; do tmux respawn-pane -k -t "$id" -c "$path"; done
}

# Monta a janela de um repo:  [repos | claude (5) / terminal (1) | direita]   ~22% : rest : ~19% (clamped)
construir() { # $1=caminho  $2=-d (não selecionar)
  local path="$1" d="${2:-}" S nome W P cmd T
  S="$(env_global WS_PERFIL)"; cmd="$(perfil_cmd "$S")"
  nome="$(basename "$path")"
  W="$(tmux new-window ${d:+-d} -P -F '#{window_id}' -t "$S:" -n "$nome" -c "$path")"
  P="$(tmux display -p -t "$W" '#{pane_id}')"
  tmux set -w -t "$W" @ws_repo "$path"; tmux set -w -t "$W" @ws_perfil "$S"
  tmux set -p -t "$P" @papel claude
  init_tabs "$W" "$P" c
  build_tree "$W" "$path" "$REPO_TREE"
  T="$(pane_with_role "$W" terminal)"
  [ -n "$T" ] && init_tabs "$W" "$T" t
  # sempre retoma a sessão mais recente do repo; se não houver, abre uma nova
  # explicit cd: ~/.zshrc jumps to $HOME on SSH logins, which would override the pane's start directory
  tmux send-keys -t "$P" "cd ${path@Q}; $cmd --continue || $cmd" Enter
  tmux select-pane -t "$P"
  mobile_apply "$W"
}

# --- Abas temporárias (Claude e terminal) -----------------------------------------------------
# Duas tiras independentes, cada uma com o mesmo padrão: a primeira aba é a principal (papel `claude`
# / `terminal`), as outras são painéis novos no mesmo repo (papel `tmp N` / `ttmp N`). Cada aba é um
# painel: a visível ocupa o espaço da principal, as demais ficam numa janela escondida
# ("tab:<repo>" / "ttab:<repo>") e trocam de lugar com swap-pane. A tira é um painel de 1 linha
# (panel_tabs.py <claude|terminal>).
tab_alive() { tmux list-panes -a -F '#{pane_id}' | grep -qxF "$1"; }

# $1=papel qualquer (principal, temporário ou da tira) -> define o tipo: c (Claude) ou t (terminal)
tab_kind() { case "$1" in terminal|ttmp*|ttabs) echo t ;; *) echo c ;; esac; }

# $1=c|t -> define K_TABS K_ACT K_NEXT K_MAIN K_TMP K_HID K_STRIP
tab_vars() {
  if [ "$1" = t ]; then
    K_TABS=@ws_ttabs K_ACT=@ws_tativo K_NEXT=@ws_tnext K_MAIN=terminal K_TMP=ttmp K_HID=ttab K_STRIP=ttabs
  else
    K_TABS=@ws_tabs K_ACT=@ws_ativo K_NEXT=@ws_next K_MAIN=claude K_TMP=tmp K_HID=tab K_STRIP=tabs
  fi
}

# $1=janela $2=painel principal da tira $3=c|t: registra a aba principal (lista, ativa, próximo número).
# Só preenche o que falta, então serve a janela nova (construir) e a existente (ensure_window) sem mudar nada.
init_tabs() {
  local W="$1" P="$2"
  tab_vars "$3"
  [ -n "$(tmux show -wqv -t "$W" $K_TABS)" ] || {
    tmux set -w -t "$W" $K_TABS "$P"; tmux set -w -t "$W" $K_ACT "$P"; tmux set -w -t "$W" $K_NEXT 2; }
}

tab_list() { # $1=janela $2=c|t: ids vivos, na ordem
  local p
  tab_vars "${2:-c}"
  # Janela criada antes das abas existirem (sessão antiga/restaurada): adota o painel principal.
  if [ -z "$(tmux show -wqv -t "$1" $K_TABS)" ]; then
    p="$(tmux list-panes -t "$1" -F '#{pane_id}|#{@papel}' | awk -F'|' -v r="$K_MAIN" '$2==r{print $1; exit}')"
    if [ -n "$p" ]; then
      tmux set -w -t "$1" $K_TABS "$p"
      [ -n "$(tmux show -wqv -t "$1" $K_ACT)" ] || tmux set -w -t "$1" $K_ACT "$p"
      tmux set -w -t "$1" $K_NEXT 2
    fi
  fi
  for p in $(tmux show -wqv -t "$1" $K_TABS); do tab_alive "$p" && echo "$p"; done
}

tab_render() { # $1=janela $2=c|t: reinicia a tira de abas (panel_tabs.py) para refletir o estado atual
  local pane kind="${2:-c}" name
  tab_vars "$kind"; name=claude; [ "$kind" = t ] && name=terminal
  pane="$(tmux list-panes -t "$1" -F '#{pane_id}|#{@papel}' | awk -F'|' -v r="$K_STRIP" '$2==r{print $1}')"
  [ -n "$pane" ] && tmux respawn-pane -k -t "$pane" "$(laco tabs "$name")"
  return 0
}

tab_show() { # $1=janela $2=painel da aba
  local W="$1" T="$2" atual kind
  tab_alive "$T" || return 1
  kind="$(tab_kind "$(tmux show -pqv -t "$T" @papel)")"; tab_vars "$kind"
  atual="$(tmux show -wqv -t "$W" $K_ACT)"
  if [ "$atual" != "$T" ]; then
    tmux swap-pane -d -s "$T" -t "$atual" || return 1
    tmux set -w -t "$W" $K_ACT "$T"
  fi
  tmux select-pane -t "$T"
  tab_render "$W" "$kind"
  tmux set -w -t "$W" @ws_mview "$([ "$kind" = t ] && echo terminal || echo claude)"
  mobile_apply "$W"
}

tab_new() { # $1=janela $2=papel do painel em foco (define o tipo; padrão Claude)
  local W="$1" S cmd path n P kind
  kind="$(tab_kind "${2:-}")"; tab_vars "$kind"
  S="$(env_global WS_PERFIL)"; cmd="$(perfil_cmd "$S")"
  [ "$kind" = t ] && cmd="${SHELL:-bash}"
  path="$(tmux show -wqv -t "$W" @ws_repo)"
  [ -n "$path" ] || return 1
  n="$(tmux show -wqv -t "$W" $K_NEXT)"; n="${n:-2}"
  P="$(tmux new-window -d -P -F '#{pane_id}' -t "$S:" -n "$K_HID:$(basename "$path")" -c "$path")"
  tmux set -p -t "$P" @papel "$K_TMP $n"; tmux set -p -t "$P" @ws_owner "$W"
  tmux set -w -t "$W" $K_TABS "$(tab_list "$W" "$kind" | tr '\n' ' ')$P"
  tmux set -w -t "$W" $K_NEXT $((n + 1))
  if [ "$kind" = t ]; then
    # Terminal: swap first, then start the shell at its final size (a resize while zsh starts
    # prints a stray "%"), with no typed command line either.
    tab_show "$W" "$P"
    tmux respawn-pane -k -t "$P" -c "$path" "cd ${path@Q}; $cmd; '$BIN/workspace' tab-exit \"\$TMUX_PANE\""
    return
  fi
  tmux send-keys -t "$P" "clear; cd ${path@Q}; $cmd; '$BIN/workspace' tab-exit \"\$TMUX_PANE\"; exit" Enter
  tab_show "$W" "$P"
}

tab_step() { # $1=janela $2=+1|-1 $3=papel do painel em foco (define o tipo)
  local W="$1" ativo ids i=0 idx=0 n kind p
  kind="$(tab_kind "${3:-}")"; tab_vars "$kind"
  ativo="$(tmux show -wqv -t "$W" $K_ACT)"
  mapfile -t ids < <(tab_list "$W" "$kind"); n=${#ids[@]}
  [ "$n" -gt 1 ] || return 0
  for p in "${ids[@]}"; do [ "$p" = "$ativo" ] && idx=$i; i=$((i + 1)); done
  tab_show "$W" "${ids[$(( (idx + $2 + n) % n ))]}"
}

tab_exit() { # $1=painel que acabou: devolve o foco ao principal e tira a aba da lista
  local P="$1" W main kind
  W="$(tmux show -pqv -t "$P" @ws_owner 2>/dev/null)"
  [ -n "$W" ] || return 0
  kind="$(tab_kind "$(tmux show -pqv -t "$P" @papel)")"; tab_vars "$kind"
  main="$(tab_list "$W" "$kind" | head -1)"
  [ "$(tmux show -wqv -t "$W" $K_ACT)" = "$P" ] && [ -n "$main" ] && tab_show "$W" "$main"
  tmux set -w -t "$W" $K_TABS "$(tab_list "$W" "$kind" | grep -vxF "$P" | tr '\n' ' ')"
  tab_render "$W" "$kind"
}

open_repo() {
  local path S ja
  path="$(readlink -f "${1/#\~/$HOME}")"; S="$(env_global WS_PERFIL)"
  [ -d "$path" ] || { msg cli.not_exists path="$path" >&2; exit 1; }
  ja="$(tmux list-windows -t "$S:" -F '#{window_id}|#{@ws_repo}' | awk -F'|' -v p="$path" '$2==p {print $1; exit}')"
  if [ -n "$ja" ]; then
    tmux select-window -t "$ja"
    # foco na tela principal: a aba ativa (ou o Claude principal)
    local foco; foco="$(tmux show -wqv -t "$ja" @ws_ativo)"
    tab_alive "$foco" 2>/dev/null || foco="$(tmux list-panes -t "$ja" -F '#{pane_id}|#{@papel}' | awk -F'|' '$2=="claude"{print $1}')"
    [ -n "$foco" ] && tmux select-pane -t "$foco"
    tmux set -w -t "$ja" @ws_mview claude   # phone: picking a repo lands on its Claude
    mobile_apply "$ja"
    return
  fi
  construir "$path"
  # a janela de partida ("boot") some quando já há repo aberto
  tmux list-windows -t "$S:" -F '#{window_id}|#{window_name}' | awk -F'|' '$2=="boot"{print $1}' |
    while read -r w; do tmux kill-window -t "$w"; done
}

side() { # $1=modo $2=janela
  local pane strip
  pane="$(pane_with_role "$2" direita)"
  [ -n "$pane" ] || return 0
  tmux set -w -t "$2" @ws_side "$1"
  tmux respawn-pane -k -t "$pane" "$(laco "$1")"
  # restart the strip so it redraws with the new active tab
  strip="$(pane_with_role "$2" dtabs)"
  [ -n "$strip" ] && tmux respawn-pane -k -t "$strip" "$(laco tabs side)"
}

# Left-top panel mode (repos | sessions), next to REPOS in the rtabs strip.
left() { # $1=repos|sessions $2=window
  local pane strip
  pane="$(pane_with_role "$2" repos)"
  [ -n "$pane" ] || return 0
  tmux set -w -t "$2" @ws_left "$1"
  tmux respawn-pane -k -t "$pane" "$(laco "$1")"
  strip="$(pane_with_role "$2" rtabs)"
  [ -n "$strip" ] && tmux respawn-pane -k -t "$strip" "$(laco tabs repos)"
  return 0
}

# Opens the repo window and submits a message in its active Claude tab.
send_prompt() { # $1=repo path $2=message
  local path W pane S
  open_repo "$1"
  path="$(readlink -f "${1/#\~/$HOME}")"; S="$(env_global WS_PERFIL)"
  W="$(tmux list-windows -t "$S:" -F '#{window_id}|#{@ws_repo}' | awk -F'|' -v p="$path" '$2==p {print $1; exit}')"
  [ -n "$W" ] || return 1
  pane="$(tmux show -wqv -t "$W" @ws_ativo)"
  tab_alive "$pane" 2>/dev/null || pane="$(tmux list-panes -t "$W" -F '#{pane_id}|#{@papel}' | awk -F'|' '$2=="claude"{print $1}')"
  tmux send-keys -t "$pane" -l "$2" && tmux send-keys -t "$pane" Enter
}

# Types text into the active Claude tab of a window, without Enter (bracketed paste: newlines stay text), and focuses it.
type_prompt() { # $1=window id $2=text
  local pane
  pane="$(tmux show -wqv -t "$1" @ws_ativo)"
  tab_alive "$pane" 2>/dev/null || pane="$(tmux list-panes -t "$1" -F '#{pane_id}|#{@papel}' | awk -F'|' '$2=="claude"{print $1}')"
  [ -n "$pane" ] || return 1
  tmux set-buffer -b ws_prompt -- "$2" && tmux paste-buffer -p -d -b ws_prompt -t "$pane"
  tmux select-pane -t "$pane"
}

resume() { # $1=id da sessão $2=janela: reabre o painel do Claude já retomando essa sessão
  local pane cmd path
  cmd="$(perfil_cmd "$(env_global WS_PERFIL)")"
  tab_show "$2" "$(tab_list "$2" | head -1)"      # retoma sempre no Claude principal
  pane="$(tmux list-panes -t "$2" -F '#{pane_id}|#{@papel}' | awk -F'|' '$2=="claude"{print $1}')"
  path="$(tmux display -p -t "$2" '#{@ws_repo}')"
  [ -n "$pane" ] || return 1
  tmux respawn-pane -k -t "$pane" -c "$path"
  tmux send-keys -t "$pane" "$cmd --resume $1" Enter
  tmux select-pane -t "$pane"
}

# Closes windows (and their hidden tab windows) whose repo is no longer in settings.json.
# Runs on reload, so removing a repo from settings cleans up the rest.
prune() { # $1=session
  local names id nome base
  names="$(python3 "$SRC/lib.py" nomes-janelas "$1")"
  [ -n "$names" ] || return 0   # unreadable/empty settings: never prune
  while IFS='|' read -r id nome; do
    [ "$nome" = boot ] && continue
    base="${nome#tab:}"; base="${base#ttab:}"
    grep -qxF -- "$base" <<<"$names" || tmux kill-window -t "$id" 2>/dev/null
  done < <(tmux list-windows -t "$1:" -F '#{window_id}|#{window_name}')
  return 0
}

# Derruba o servidor e sobe de novo (o Claude volta com `claude --continue`).
# Serve para os hooks/config novos valerem: detach não basta, o Claude só lê os hooks ao abrir.
restart() {
  local perfil="${1:-claude}" sock="ws-${1:-claude}"
  if env -u TMUX tmux -L "$sock" has-session -t "$perfil" 2>/dev/null; then
    env -u TMUX tmux -L "$sock" kill-server
    sleep 1
  fi
  iniciar "$perfil"
}

# Reinicia os painéis (repos, lateral direita, tira de abas) relendo o código: mata o python de cada um
# e o laço `while :` o sobe de novo em ~1s. Não mexe no Claude nem no terminal.
panels() { # $1=perfil (padrão: claude)
  local perfil="${1:-claude}" sock="ws-${1:-claude}" pid
  tmux -L "$sock" has-session -t "$perfil" 2>/dev/null || { msg cli.no_workspace profile="$perfil" >&2; exit 1; }
  while read -r pid; do
    pkill -TERM -P "$pid" -f 'python3 .*/panel_' 2>/dev/null
  done < <(tmux -L "$sock" list-panes -a -F '#{pane_pid}|#{@papel}' | awk -F'|' '$2=="repos"||$2=="tasks"||$2=="direita"||$2=="tabs"||$2=="ttabs"||$2=="dtabs"||$2=="rtabs"||$2=="ktabs"{print $1}')
  return 0
}

# --- Phone layout --------------------------------------------------------------------------------
# On a narrow window (portrait phone) the window shows ONE pane at a time (tmux zoom): Claude by default,
# and the hamburger menu (status bar, or ctrl+b m) picks the view. State: window option @ws_mview.
is_mobile() { [ "$(tmux display -p -t "$1" '#{window_width}')" -lt "$MOBILE_W" ]; }

mview_target() { # $1=window $2=claude|terminal|repos|tasks|side -> pane id
  local W="$1" p=""
  case "$2" in
    claude) p="$(tmux show -wqv -t "$W" @ws_ativo)"; tab_alive "$p" 2>/dev/null || p="$(pane_with_role "$W" claude)" ;;
    terminal) p="$(tmux show -wqv -t "$W" @ws_tativo)"; tab_alive "$p" 2>/dev/null || p="$(pane_with_role "$W" terminal)" ;;
    repos) p="$(pane_with_role "$W" repos)" ;;
    tasks) p="$(pane_with_role "$W" tasks)" ;;
    side) p="$(pane_with_role "$W" direita)" ;;
  esac
  echo "$p"
}

# Idempotent: zooms the current view on a narrow window, undoes our zoom on a wide one.
mobile_apply() { # $1=window
  local W="$1" view target
  [ -n "$(tmux show -wqv -t "$W" @ws_repo)" ] || return 0   # plugin windows keep their own layout
  if ! is_mobile "$W"; then
    if [ "$(tmux show -wqv -t "$W" @ws_mzoom)" = 1 ]; then
      [ "$(tmux display -p -t "$W" '#{window_zoomed_flag}')" = 1 ] && tmux resize-pane -Z -t "$W"
      tmux set -wu -t "$W" @ws_mzoom
    fi
    return 0
  fi
  view="$(tmux show -wqv -t "$W" @ws_mview)"; view="${view:-claude}"
  target="$(mview_target "$W" "$view")"; [ -n "$target" ] || return 0
  tmux set -w -t "$W" @ws_mzoom 1
  if [ "$(tmux display -p -t "$W" '#{window_zoomed_flag}')" = 1 ]; then
    tmux select-pane -Z -t "$target"
  else
    tmux select-pane -t "$target"; tmux resize-pane -Z -t "$target"
  fi
}

mview() { # $1=window $2=view $3=optional mode (repos: repos|sessions, side: tree|diff|github)
  local W="$1"
  case "$2" in
    repos) [ -n "${3:-}" ] && left "$3" "$W" ;;
    side) [ -n "${3:-}" ] && side "$3" "$W" ;;
  esac
  tmux set -w -t "$W" @ws_mview "$2"
  mobile_apply "$W"
  return 0
}

# Hamburger menu (labels are the @t_menu_* i18n options, expanded by tmux).
menu() { # $1=client $2=window
  local C="$1" W="$2" w="$BIN/workspace"
  tmux display-menu -c "$C" -T '#{@t_menu_title}' -x C -y C \
    '#{@t_menu_claude}' c "run-shell -b \"$w mview $W claude\"" \
    '#{@t_menu_terminal}' t "run-shell -b \"$w mview $W terminal\"" \
    '' \
    '#{@t_menu_repos}' r "run-shell -b \"$w mview $W repos repos\"" \
    '#{@t_menu_sessions}' s "run-shell -b \"$w mview $W repos sessions\"" \
    '#{@t_menu_tasks}' k "run-shell -b \"$w mview $W tasks\"" \
    '#{@t_menu_tree}' f "run-shell -b \"$w mview $W side tree\"" \
    '#{@t_menu_diff}' d "run-shell -b \"$w mview $W side diff\"" \
    '#{@t_menu_github}' g "run-shell -b \"$w mview $W side github\"" \
    '' \
    '#{@t_menu_tab_new}' n "run-shell -b \"$w tab-new $W claude\"" \
    '#{@t_menu_tab_next}' p "run-shell -b \"$w tab-step $W 1 claude\"" \
    '#{@t_menu_tterm_new}' N "run-shell -b \"$w tab-new $W terminal\"" \
    '#{@t_menu_tterm_next}' P "run-shell -b \"$w tab-step $W 1 terminal\""
}

# Re-applies only the pane sizes of one window (cheap; used by ensure_window and the tmux hooks).
fit_window() { # $1=window
  local W="$1" P larg id
  P="$(tmux list-panes -t "$W" -F '#{pane_id}|#{@papel}' | awk -F'|' '$2=="claude"{print $1; exit}')"
  [ -n "$P" ] || return 0
  if is_mobile "$W"; then mobile_apply "$W"; return 0; fi
  larg="$(tmux display -p -t "$W" '#{window_width}')"
  role_pane() { tmux list-panes -t "$W" -F '#{pane_id}|#{@papel}' | awk -F'|' -v r="$1" '$2==r{print $1; exit}'; }
  id="$(role_pane repos)";    [ -n "$id" ] && tmux resize-pane -t "$id" -x "$(col_w left "$larg")"
  id="$(role_pane direita)";  [ -n "$id" ] && tmux resize-pane -t "$id" -x "$(col_w right "$larg")"
  id="$(role_pane terminal)"; [ -n "$id" ] && tmux resize-pane -t "$id" -y "$(( $(term_h "$P") - 1 ))"
  id="$(role_pane ttabs)";    [ -n "$id" ] && tmux resize-pane -t "$id" -y 1
  id="$(role_pane tabs)";     [ -n "$id" ] && tmux resize-pane -t "$id" -y 2
  id="$(role_pane dtabs)";    [ -n "$id" ] && tmux resize-pane -t "$id" -y 2
  id="$(role_pane rtabs)";    [ -n "$id" ] && tmux resize-pane -t "$id" -y 2
  id="$(role_pane ktabs)";    [ -n "$id" ] && tmux resize-pane -t "$id" -y 1
  mobile_apply "$W"   # wide window: undoes the phone zoom, if any
}

# Plugin windows: the plugins listed in settings.json ("plugins" por perfil), one window "plugin:<id>" each.
# Nothing is discovered (see src/lib.py). lib.py checks plugin.json and prints only the valid ones, so a
# broken plugin shows its error here and the other windows are still built.
# Mode bar on top of every plugin window (full width, above the plugin's own layout): the rtabs strip
# of panel_tabs.py, which lists REPOS and the plugins. The plugin owns its layout, so the bar is added here.
BARRA_PLUGIN='rtabs|claude|vb|2|tabs:repos'

plugin_abrir() { # $1=perfil $2=id $3=pasta $4=rótulo $5=árvore (ver REPO_TREE)
  local S="$1" nome="plugin:$2" W
  W="$(tmux list-windows -t "$S:" -F '#{window_id}|#{window_name}' | awk -F'|' -v n="$nome" '$2==n{print $1; exit}')"
  if [ -z "$W" ]; then
    W="$(tmux new-window -d -P -F '#{window_id}' -t "$S:" -n "$nome" -c "$3")"
    tmux set -p -t "$(tmux display -p -t "$W" '#{pane_id}')" @papel claude
  fi
  # the bar comes first, so it takes the top row; ensure_window creates it only when missing
  ensure_window "$W" "$3" "$BARRA_PLUGIN"$'\n'"$5"
  msg plugin.opened label="$4" id="$2"
}

plugin_sync() { # $1=perfil: abre ou completa a janela de cada plugin listado (idempotente)
  local S="${1:-claude}" bloco="" id="" dir="" label="" linha
  while IFS= read -r linha; do
    if [[ "$linha" == @@* ]]; then
      [ -n "$id" ] && plugin_abrir "$S" "$id" "$dir" "$label" "$bloco"
      IFS=$'\t' read -r id dir label <<<"${linha#@@}"
      bloco=""
    else
      bloco+="$linha"$'\n'
    fi
  done < <(python3 "$SRC/lib.py" plugins "$S")
  [ -n "$id" ] && plugin_abrir "$S" "$id" "$dir" "$label" "$bloco"
  return 0
}

# Checks an open window and creates what is missing (tab strips, repos, side, terminal) without touching
# what exists. New structural changes go in REPO_TREE, and `reload` applies them without a restart.
# $3 = árvore de painéis (padrão REPO_TREE; plugins passam a própria). Plugin windows have no @ws_repo.
ensure_window() { # $1=janela $2=caminho do repo $3=árvore
  local W="$1" path="$2" P T
  P="$(pane_with_role "$W" claude)"; [ -n "$P" ] || return 0
  init_tabs "$W" "$P" c
  build_tree "$W" "$path" "${3-$REPO_TREE}"
  T="$(pane_with_role "$W" terminal)"
  [ -n "$T" ] && init_tabs "$W" "$T" t
  fit_window "$W"
}

# Light subcommand: re-applies the pane sizes in every window of the profile (no panel restart).
fit() {
  local perfil="${1:-claude}" sock="ws-${1:-claude}" W
  tmux -L "$sock" has-session -t "$perfil" 2>/dev/null || return 0
  export TMUX="$(tmux -L "$sock" display -p '#{socket_path},#{pid},0')"
  export WS_PERFIL="$perfil"
  while read -r W; do fit_window "$W"; done < <(tmux list-windows -t "$perfil:" -F '#{window_id}')
}

# Aplica config/tmux.conf novo e a tira de abas nas janelas já abertas, sem derrubar o servidor.
reload() {
  local perfil="${1:-claude}" sock="ws-${1:-claude}" W P path strip
  tmux -L "$sock" has-session -t "$perfil" 2>/dev/null || { msg cli.no_workspace profile="$perfil" >&2; exit 1; }
  export TMUX="$(tmux -L "$sock" display -p '#{socket_path},#{pid},0')"
  export WS_PERFIL="$perfil"
  tmux source-file "$AQUI/config/tmux.conf"
  prune "$perfil"
  while IFS='|' read -r W path; do
    [ -n "$path" ] && ensure_window "$W" "$path"
  done < <(tmux list-windows -t "$perfil:" -F '#{window_id}|#{@ws_repo}')
  plugin_sync "$perfil"
  panels "$perfil"
  tmux refresh-client -S 2>/dev/null; msg cli.reloaded profile="$perfil"
}

iniciar() {
  local perfil="${1:-claude}" cmd sock primeiro
  cmd="$(perfil_cmd "$perfil")"
  [ -n "$cmd" ] || { msg cli.unknown_profile profile="$perfil" >&2; exit 2; }
  sock="ws-$perfil"
  if ! env -u TMUX tmux -L "$sock" has-session -t "$perfil" 2>/dev/null; then
    export WS_PERFIL="$perfil"
    env -u TMUX tmux -L "$sock" -f "$AQUI/config/tmux.conf" new-session -d -s "$perfil" -n boot \
      -x "${WS_COLS:-$(tput cols 2>/dev/null || echo 200)}" -y "${WS_LINES:-$(tput lines 2>/dev/null || echo 50)}"
    env -u TMUX tmux -L "$sock" set-environment -g WS_PERFIL "$perfil"
    env -u TMUX tmux -L "$sock" set-environment -g WS_DIR "$AQUI"
    if [ "$(env -u TMUX tmux -L "$sock" list-windows -t "$perfil:" -F '#{window_name}' | grep -vc '^boot$')" -eq 0 ]; then
      primeiro="$(python3 "$SRC/lib.py" repo-inicial)"
      env -u TMUX tmux -L "$sock" run-shell "$BIN/workspace open '$primeiro'"
    fi
    env -u TMUX tmux -L "$sock" run-shell "$BIN/workspace plugins-sync '$perfil'"
  fi
  [ -n "${WS_SEM_ANEXAR:-}" ] && return 0
  exec env -u TMUX tmux -L "$sock" attach -t "$perfil"
}

install() {
  mkdir -p "$HOME/.local/bin"
  ln -sf "$BIN/workspace" "$HOME/.local/bin/workspace"
  msg cli.installed
}

install_hooks() {
  python3 - "$SRC/hook.py" <<'PY'
import json, shutil, sys
from pathlib import Path
hook = sys.argv[1]
f = Path.home() / ".claude" / "settings.json"
cfg = json.loads(f.read_text())
shutil.copy(f, f.with_suffix(".json.bak-workspace"))
novo = 0
for ev in ("SessionStart", "UserPromptSubmit", "PreToolUse", "PostToolUse", "PostToolUseFailure",
           "PermissionRequest", "Notification", "Stop", "SessionEnd"):
    grupos = cfg.setdefault("hooks", {}).setdefault(ev, [])
    if any(hook in h.get("command", "") for g in grupos for h in g.get("hooks", [])):
        continue
    grupos.append({"hooks": [{"type": "command", "command": f"python3 {hook}", "timeout": 5}]})
    novo += 1
f.write_text(json.dumps(cfg, indent=2, ensure_ascii=False) + "\n")
print(f"hooks registrados em {novo} evento(s); backup em settings.json.bak-workspace. Sessões abertas precisam reiniciar.")
PY
}

case "${1:-}" in
  open) shift; open_repo "$@" ;;
  side) shift; side "$@" ;;
  left) shift; left "$@" ;;
  send) send_prompt "$2" "$3" ;;
  type) type_prompt "$2" "$3" ;;
  options) tmux display-popup -c "$2" -E -w 80% -h 70% -d "$AQUI" "python3 $SRC/options.py $3" ;;
  resume) shift; resume "$@" ;;
  tab-new) tab_new "$2" "${3:-}" ;;
  tab-show) tab_show "$2" "$3" ;;
  tab-step) tab_step "$2" "$3" "${4:-}" ;;
  tab-exit) tab_exit "$2" ;;
  plugins-sync) plugin_sync "${2:-claude}" ;;
  install) install ;;
  install-hooks) install_hooks ;;
  stop) tmux -L "ws-${2:-claude}" kill-server ;;
  restart) shift; restart "$@" ;;
  reload) shift; reload "$@" ;;
  fit) shift; fit "$@" ;;
  mview) shift; mview "$@" ;;
  menu) menu "$2" "$3" ;;
  ""|-*) iniciar claude ;;
  *) msg cli.unknown_command command="$1" >&2; exit 2 ;;
esac
