{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"${WS_PYTHON:-python3}\" \"$HOME/.local/share/ai-tmux-workspace/security/gate.py\"",
            "type": "command"
          }
        ],
        "matcher": "Read"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"${WS_PYTHON:-python3}\" \"$HOME/.local/share/ai-tmux-workspace/security/gate.py\"",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|NotebookEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"${WS_PYTHON:-python3}\" \"$HOME/.local/share/ai-tmux-workspace/security/gate.py\"",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "\"${WS_PYTHON:-python3}\" \"$HOME/.local/share/ai-tmux-workspace/security/gate.py\"",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(sudo:*)",
      "Edit(./**/.env)",
      "Edit(./**/*.pem)",
      "Edit(./**/*.key)"
    ]
  }
}
